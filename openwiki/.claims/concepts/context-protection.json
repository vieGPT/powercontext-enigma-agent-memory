    {
      "id": "claim_9279ceac45fe4307b9637e3a6bd86b15",
      "statement": "Before_send prepared-context validation requires each located block to be a user-message text in the protocol's supported position, strictly ordered and non-overlapping, on UTF-8 boundaries, with bytes matching the reuse proof's content_bytes and SHA-256 digest and with historical-data trust; historical markers not covered by a bound locator are rejected.",
      "evidence": [
        {
          "resource": "repo://src/powercontext/builtin/runtime/context_check.py#L165-L198",
          "version": "repo-lines-v1:sha256:03acdf7249b8e75dda38737984924619a5f8fb7afe12999145c0e9e5718d7e5d:"
