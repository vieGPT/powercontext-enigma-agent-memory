    {
      "id": "claim_0f0b0d622a804dd4a11fd08aacb8a181",
      "statement": "The context check accepts two phases: before_send, carrying the exact JSON payload and prepared-context locations, and before_release, carrying the complete raw response, a request_binding from the send permit, and completion set to complete.",
      "evidence": [
        {
          "resource": "repo://src/powercontext/builtin/runtime/context_check.py#L65-L121",
          "version": "repo-lines-v1:sha256:454df358e25bbbabf3c4c5473ee4aa36da5f3c9cc754a515128a6a1cd899ded1:"
        }
      ]
    },
    {
      "id": "claim_2b7aa29c7be74ac18277eb364282ad4e",
      "statement": "check_context returns one of the verdicts allow, block, or withhold, and only allow with complete coverage permits the corresponding action; an allow without complete coverage is converted to withhold.",
      "evidence": [
        {
          "resource": "repo://src/powercontext/builtin/runtime/context_check.py#L123-L130",
          "version": "repo-lines-v1:sha256:413f728c0a305352e6f3812c08b785f53670e46c5d496407ed2d3ac75e23a6f4:"
