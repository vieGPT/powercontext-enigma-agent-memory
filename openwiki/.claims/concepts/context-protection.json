    {
      "id": "claim_820763b68b7e40cbbf152a4b884d1bfe",
      "statement": "Before_release correlation opens the send binding under the send purpose and requires matching identity, Scope, target profile, policy fingerprint and phase before_send, then revalidates every retained prepared binding through current reuse validation.",
