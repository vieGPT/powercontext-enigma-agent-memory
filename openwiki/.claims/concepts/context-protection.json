    {
      "id": "claim_a5ede6a3dad2483282daafa51f9651ef",
      "statement": "The send permit's deadline is the earlier of 60 seconds (SEND_VALIDITY) and the earliest reuse proof expiry, while the send binding remains correlatable for 300 seconds (RESPONSE_CORRELATION); the release permit is sealed until its own 60-second deadline and correlation does not extend it.",
      "evidence": [
        {
          "resource": "repo://src/powercontext/builtin/runtime/context_check.py#L37-L48",
          "version": "repo-lines-v1:sha256:1f90ac328417456a6312f785a997bb4293faee97df64f6c040ea7b2aaed4ba51:"
