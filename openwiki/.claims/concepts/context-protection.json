    },
    {
      "id": "claim_cebd5615c8ef4fe3af662e5671ec05bb",
      "statement": "When the deployment is not in enforcing mode, check_context returns withhold with reason enforcement-not-configured for either phase, so observation modes never grant a check permit.",
      "evidence": [
        {
          "resource": "repo://src/powercontext/builtin/runtime/context_check.py#L340-L360",
          "version": "repo-lines-v1:sha256:2b569bf51dd1849be63f692c4444376856ddc5ae185fc4c4237b402dc2cb5f45:"
        }
      ]
    },
    {
      "id": "claim_84c673830f044cf08f51cfdbdcd5f047",
      "statement": "check_context rejects bodies that are not valid UTF-8 and bodies larger than the phase limit (max_payload_bytes for send, max_response_bytes for release, capped at 1,048,576 bytes), raising errors instead of returning a verdict.",
