    },
    {
      "id": "claim_6ea1f69a1db046ea99ac64a5aaf8fd2c",
      "statement": "Expansion rounds change only the admission floor: round 1 uses a semantic floor of 0.15 and round 2 uses 0.10, and a SearchPlan never sets a limit, search mode, or rerank candidate bound.",
      "evidence": [
        {
          "resource": "repo://src/powercontext/builtin/runtime/recall_sufficiency.py#L190-L240",
          "version": "repo-lines-v1:sha256:dc2943ed2ab8833b94ebdc9c50ca29e2812359fb8240a6ceb390c83f51bb7b02:"
        }
