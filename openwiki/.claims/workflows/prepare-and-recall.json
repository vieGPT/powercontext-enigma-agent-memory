    {
      "id": "claim_018cd750c79c4afdb49e172fb0884417",
      "statement": "The recall-sufficiency gate is a pure, model-free verdict that checks, in order, no-content, budget-floor, rerank-enabled, thin-candidates, thin-families, weak-top-1, weak-lexical, and then sufficient.",
      "evidence": [
        {
          "resource": "repo://src/powercontext/builtin/runtime/recall_sufficiency.py#L479-L512",
          "version": "repo-lines-v1:sha256:4405f1474078480cc861058e2c878d7715610024babfb27b713869fd48e3e916:"
        }
      ]
    },
    {
      "id": "claim_209b4e048b304d328da844733842fb13",
      "statement": "The gate policy is disabled by default; when enabled, it allows at most recall_gate_max_rounds expansion rounds (default 2, capped at 2) and uses default thresholds of 2 minimum candidates, 0.35 top score, 0.02 top gap, and 0.5 lexical overlap.",
      "evidence": [
        {
          "resource": "repo://src/powercontext/builtin/runtime/config.py#L177-L185",
          "version": "repo-lines-v1:sha256:c37d3a2ca013aa11c2feaee9a26d941e373f2ef6c3815c192ceb1cae6b42f011:"
