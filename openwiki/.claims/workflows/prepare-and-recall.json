  "claims": [
    {
      "id": "claim_02e8fa01e23e4249af47fb1d36545330",
      "statement": "The Codex hook reduces a submitted prompt to a bounded recall query: a prompt within 8192 characters and 8192 UTF-8 bytes is used trimmed, while a longer prompt keeps its tail, cut by character and then by UTF-8 byte without splitting a character.",
      "evidence": [
        {
          "resource": "repo://integrations/codex/plugins/powercontext/hooks/prepared_context.py#L26-L30",
          "version": "repo-lines-v1:sha256:4104a448b996c4e8a87f0856e4b5a5640d8e1d09ea1e0fecdc41b3c8a1f7840b:"
        },
        {
          "resource": "repo://integrations/codex/plugins/powercontext/hooks/prepared_context.py#L71-L89",
          "version": "repo-lines-v1:sha256:6b392a8f71d0755bcbf354de20dccb6eaa0d506a54527420f80acf1cf9ff2bac:"
        }
      ]
    },
    {
      "id": "claim_e52a8ecdfb294e7187293bd79d2fe672",
      "statement": "PrepareContextRequest requires a query of 1 to 8192 characters containing non-whitespace text, and max_bytes defaults to 8000 within a permitted range of 512 to 32768.",
      "evidence": [
        {
          "resource": "repo://src/powercontext/builtin/runtime/models.py#L329-L346",
          "version": "repo-lines-v1:sha256:a901231641b7c9b5a3537256bccd149e79db2bebd5ca0d94f2b365ea9ecd1ce9:"
        }
      ]
    },
    {
      "id": "claim_d9f2c8b7b4d247b4b0d90bb551b67e23",
      "statement": "The Codex hook calls POST /v1/context/prepare with max_bytes 8000, adds include_code, assembly, or bootstrap_receipt_id only when configured, and never requests include_receipt, so automatic recall receives the four-field envelope.",
      "evidence": [
        {
          "resource": "repo://integrations/codex/plugins/powercontext/hooks/recall.py#L236-L258",
          "version": "repo-lines-v1:sha256:3105ea180dd600ff10d721788e8faa7c6caa344e370729533ec7e3dec362cf24:"
        }
      ]
    },
    {
      "id": "claim_3415a8e1be604ac1a0affd2cb867f023",
      "statement": "The HTTP prepare route converts the transport request by dropping scope_id from the body, which selects the Scope, and when access control is configured it requires read permission on the target Scope and every referenced Scope before preparing.",
      "evidence": [
        {
          "resource": "repo://src/powercontext/server/app.py#L3570-L3599",
          "version": "repo-lines-v1:sha256:3f3f4d1a56aa445781784b2fe851e7f9c2cd7d7bbbd3496bbf70e38a2bcb033a:"
