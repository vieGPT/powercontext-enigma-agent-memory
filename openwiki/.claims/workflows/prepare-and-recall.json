    {
      "id": "claim_e92589245fc24dd1aed60ec017cef5b8",
      "statement": "Each preparation shares one query-embedding wait budget, whose default recall_embedding_timeout_seconds is 0.5 seconds and whose configured maximum is 60 seconds; only the time spent waiting on embeddings is charged to it.",
