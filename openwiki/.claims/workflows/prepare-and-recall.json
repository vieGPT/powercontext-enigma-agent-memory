    },
    {
      "id": "claim_710a502c4f18426991d19eb79a1872b8",
      "statement": "The expansion loop runs while the verdict is insufficient, families remain recoverable, and expansions are below the cap; when still insufficient at the cap, a non-weak-top-1 verdict becomes at-max-rounds, and any error keeps the last committed candidates, records expansion-failed, and lets the preparation succeed.",
      "evidence": [
        {
          "resource": "repo://src/powercontext/builtin/runtime/application.py#L1607-L1650",
          "version": "repo-lines-v1:sha256:1e6a02c616d79f6bed7c165c6ccd646a802ba2fc075b14ff8c2a88b628b7856b:"
