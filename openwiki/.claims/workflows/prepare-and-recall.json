    {
      "id": "claim_daea3a5a54354415a6c9bfd8d9fc7176",
      "statement": "Entries that do not fit whole are truncated to the longest prefix that fits, but only down to a minimum of 64 bytes; shorter fits are dropped as below-min-bytes and entries with no fitting truncation are dropped as no-fitting-truncation.",
