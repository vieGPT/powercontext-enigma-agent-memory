    {
      "id": "claim_41081c6f65c040389b493f6ebb22839e",
      "statement": "A receipt is attached only when include_receipt is set; if the receipt is incomplete or its serialized form exceeds 8192 bytes, the transport layer drops it and returns the four-field envelope.",
      "evidence": [
