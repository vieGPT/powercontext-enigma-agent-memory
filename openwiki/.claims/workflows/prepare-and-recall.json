    {
      "id": "claim_1a48dd323c52455c9ef69da9fdbc7e64",
      "statement": "Topic Memory reuses the Memory query vector when both use the same embedding model and the query fits Topic search limits; otherwise it embeds its own query, and it falls back to FTS when the shared embedding budget is exhausted.",
      "evidence": [
        {
          "resource": "repo://src/powercontext/builtin/runtime/application.py#L1950-L1966",
