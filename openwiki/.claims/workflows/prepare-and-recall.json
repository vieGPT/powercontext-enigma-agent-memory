    {
      "id": "claim_cfaae373ac51494aa33e51791b603c06",
      "statement": "With include_reuse the response becomes PreparedContextWithReuse, and the reuse binding attaches to the final selected origins and their observed lifecycle versions rather than to every recalled candidate.",
      "evidence": [
        {
          "resource": "repo://src/powercontext/builtin/runtime/application.py#L1246-L1268",
