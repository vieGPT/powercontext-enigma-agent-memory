    {
      "id": "claim_692477b2ba5d43ea96707ad4d0df76ac",
      "statement": "The Codex hook fails open: an HTTP 503 or a timeout or socket error records server_unavailable, a 401 records authentication_failed, a 404 without an error code records version_mismatch, other unexpected responses or invalid envelopes record invalid_response, and an empty response emits an empty event; none of these inject context.",
      "evidence": [
        {
          "resource": "repo://integrations/codex/plugins/powercontext/hooks/recall.py#L431-L490",
          "version": "repo-lines-v1:sha256:1dbe887abe513fc6bc18b8a88c4639e79104e0cc396e388ea0086f4c0a865213:"
        },
        {
          "resource": "repo://integrations/codex/plugins/powercontext/hooks/recall.py#L99-L111",
