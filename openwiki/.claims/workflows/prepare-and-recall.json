    {
      "id": "claim_03b99bec64674d61bab0b13a26d6fa93",
      "statement": "Reuse across referenced Scopes is unsupported: include_reuse fails with context-reuse-cross-scope-unsupported when the Scope has context references.",
      "evidence": [
        {
          "resource": "repo://src/powercontext/builtin/runtime/application.py#L1130-L1134",
