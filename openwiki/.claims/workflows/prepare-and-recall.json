    {
      "id": "claim_2db48f8a5f974566b9ec487d8d9a584e",
      "statement": "The PreparedContext envelope has schema, status, content, and content_bytes, with an empty context requiring null content and zero bytes, and a ready context requiring non-blank content whose UTF-8 length equals content_bytes; the Codex hook validates this shape and rejects content above 8000 bytes.",
      "evidence": [
        {
          "resource": "repo://integrations/codex/plugins/powercontext/hooks/prepared_context.py#L36-L66",
          "version": "repo-lines-v1:sha256:c3f1be63adaee87044e3fa09ac0c669a6e482b2d7fe893a7a4012fcbccae4be7:"
