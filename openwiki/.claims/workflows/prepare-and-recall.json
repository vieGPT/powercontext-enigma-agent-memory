        }
      ]
    },
    {
      "id": "claim_3af3f39f37524585aa7d248cdbc653af",
      "statement": "ScopedContextApplication.prepare returns an empty result without recall when assembly is present with an empty sections list and neither include_code nor include_reuse is set, attaching a receipt only when include_receipt is set.",
      "evidence": [
        {
          "resource": "repo://src/powercontext/builtin/runtime/application.py#L1093-L1128",
